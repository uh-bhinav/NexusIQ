{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker ps:*)",
      "Bash(mvn test:*)",
      "Bash(mvn verify:*)",
      "Bash(mvn compile:*)",
      "Bash(./mvnw test:*)",
      "Bash(./mvnw verify:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(mypy:*)",
      "Bash(uv run:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(make:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(docker compose down -v:*)",
      "Bash(git push --force:*)"
    ]
  }
}
