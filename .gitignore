# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.crt
secrets/
**/credentials.json
**/service-account*.json

# ---- Java / Maven ----
target/
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
*.class
*.jar
!maven-wrapper.jar
*.war
hs_err_pid*
replay_pid*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# ---- Model / embedding caches (large, reproducible) ----
# /models/ anchored to repo root — unanchored, it matched the real source
# package ai-service/app/models/ (same bug as /storage/ above, same fix).
.cache/
/models/
.huggingface/

# ---- Evaluation harness run output (transient; the baseline is
# docs/AI/EVALUATION_BASELINE.md, committed deliberately, not every run) ----
ai-service/app/evaluation/datasets/results/
sentence-transformers/

# ---- Node / frontend ----
node_modules/
.vite/
frontend/web/dist/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Local runtime data ----
# Anchored to the repo root (leading /): unanchored patterns match a
# directory of this name ANYWHERE in the tree, which silently swallowed the
# real source package backend/spring-api/.../document/storage/ — confirmed
# via `git check-ignore -v`, the files existed on disk but `git status` never
# saw them.
/data/
/storage/
/uploads/
logs/
*.log
docker-compose.override.yml

# ---- IDE / OS ----
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ---- Claude Code ----
# Shared project config IS committed: CLAUDE.md, .claude/rules, .claude/skills,
# .claude/settings.json. Personal/local overrides are not.
.claude/settings.local.json
.claude/local/
.claude/memory/
