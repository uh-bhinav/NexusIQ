# NexusIQ environment contract.
# Copy to .env and fill in. NEVER commit .env.
# Every variable consumed by any service must be declared here.

# ============================================================
# Core
# ============================================================
NEXUSIQ_ENV=local                      # local | ci | prod
LOG_LEVEL=INFO

# ============================================================
# PostgreSQL (system of record + pgvector)
# ============================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexusiq
POSTGRES_USER=nexusiq
POSTGRES_PASSWORD=change-me-locally
# Host-side port mapping for psql/IDE access
POSTGRES_EXPOSED_PORT=5434

# ============================================================
# Redis (cache / rate limiting / SSE fan-out — never source of truth)
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXPOSED_PORT=6380

# ============================================================
# Kafka (KRaft mode, single broker locally)
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP=localhost:29093
KAFKA_CONSUMER_GROUP_AI=nexusiq-ai-service
KAFKA_CONSUMER_GROUP_API=nexusiq-api

# ============================================================
# Backend (Spring Boot)
# ============================================================
API_PORT=8080
JWT_SECRET=change-me-min-32-bytes-of-random-entropy
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173
AI_SERVICE_BASE_URL=http://ai-service:8000
# Shared secret for service-to-service calls (Java <-> Python)
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# ============================================================
# AI service (FastAPI + LangGraph)
# ============================================================
AI_SERVICE_PORT=8000

# --- LLM provider abstraction (see docs/AI/MODEL_STRATEGY.md, ADR-008) ---
# gemini | anthropic | openai | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_MODEL_HEAVY=gemini-3.6-flash     # used for synthesis/validation nodes (verify availability for your key — Google can retire model ids for a given API key/project without notice, confirmed 2026-08-11)
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Embeddings: local, zero-cost (see ADR-009) ---
# local | gemini | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL_VERSION=1             # bump forces controlled re-embedding
EMBEDDING_BATCH_SIZE=32

# --- Reranking ---
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=20
RERANK_TOP_N=8
RETRIEVAL_MIN_SIMILARITY=0.30
RETRIEVAL_CACHE_TTL_SECONDS=300
CONTEXT_TOKEN_BUDGET=4000

# --- Workflow budgets (hard stops; see docs/AI/GUARDRAILS.md) ---
MAX_AGENT_ITERATIONS=2
MAX_WORKFLOW_TOKENS=200000
MAX_WORKFLOW_COST_USD=0.50
WORKFLOW_TIMEOUT_SECONDS=300

# --- Human-in-the-loop thresholds (deterministic gate) ---
HITL_MIN_CONFIDENCE=0.75
HITL_ESCALATE_ON_RISK=HIGH
HITL_MIN_EVIDENCE_COVERAGE=0.80

# ============================================================
# Document storage (abstracted: local | s3)
# ============================================================
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/var/nexusiq/documents
MAX_UPLOAD_MB=25

# ============================================================
# Observability
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SERVICE_NAME=nexusiq
# spring-api's OTLP tracing autoconfiguration is HTTP-only (management.otlp.*),
# distinct from ai-service's gRPC exporter above — same collector, different
# OTLP transport, both valid.
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://otel-collector:4318
# Grafana's local admin password — never reused outside this local stack.
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================
# Frontend (Vite — anything prefixed VITE_ is PUBLIC)
# ============================================================
VITE_API_BASE_URL=http://localhost:8080/api/v1
# NEVER put LLM_API_KEY or any secret behind a VITE_ prefix.

# ============================================================
# Host port block
# ============================================================
# Deliberately non-default so NexusIQ can run alongside other local stacks.
# Container-internal ports are always standard; only host mappings shift.
KAFKA_EXPOSED_PORT=29093
KAFKA_UI_PORT=8091
OTEL_GRPC_PORT=4327
OTEL_HTTP_PORT=4328
OTEL_HEALTH_PORT=13134
OTEL_PROMETHEUS_PORT=8889
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
